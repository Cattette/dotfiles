#!/bin/bash

# launch terminal
"$TERMINAL"
    m:0x40 + c:36
    Mod4 + Return

# run rofi launcher
"exec rofi -show combi -modes combi -combi-modes "window,drun,run""
    m:0x4 + c:65
    Control + space

# run rofi/greenclip selector
"rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'"
    m:0x40 + c:33
    Mod4 + p

# take snip screenshot to clipboard
# "maim -s --bordersize=3 --color=255,0,0 | xclip -selection clipboard -t image/png"
"bash $HOME/dotfiles/scripts/shotgun"
    m:0x41 + c:39
    Shift+Mod5 + s

# color picker to clipboard
"xcolor -s clipboard"
    m:0x41 + c:54
    Shift+Mod4 + c
# tweak brightness öä
"brightnessctl set +10"
    m:0x8 + c:34
    Alt + bracketleft

 "brightnessctl set 10-"
    m:0x8 + c:35
    Alt + bracketright

#powermenu
"~/.config/i3/scripts/powermenu"
    Mod4 + Escape
    
# media control
"playerctl play-pause"
    m:0x0 + c:172
    XF86AudioPlay
"playerctl play-pause"
    m:0x0 + c:208
    XF86AudioPlay
"playerctl next"
    m:0x0 + c:171
    XF86AudioNext
"playerctl prev"
    m:0x0 + c:171
    XF86AudioNext
# launch browser
"exec $BROWSER"
    m:0x40 + c:56
    Mod4 + b

"dolphin"
    m:0x40 + c:57
    Mod4 + n

"$TERM nnn"
    m:0x40 + c:55
    Mod4 + v

# keyboard brightness
"brightnessctl --device='asus::kbd_backlight' set +1"
    m:0x10 + c:238
    Mod2 + XF86KbdBrightnessUp
"brightnessctl --device='asus::kbd_backlight' set 1-"
    m:0x10 + c:237
    Mod2 + XF86KbdBrightnessDown

# rofi calculator
"rofi -show calc -modi calc -no-show-match -no-sort -calc-command "echo -n '{result}' | xclip -selection clipboard""
    m:0x40 + c:58
    Mod4 + m

# right click
"xdotool click 3"
    m:0x0 + c:69
    F3

# middle click
"xdotool click 2"
    F2

# main click
"xdotool click 1"
    F1

"rofi -show bl -modes "bl:$HOME/dotfiles/.config/rofi-utils/rofi-utils""
    m:0x40 + c:54
    Mod4 + c

"bash $HOME/dotfiles/scripts/record"
    m:0x40 + c:42
    Mod4 + g

"amixer set Master 2%+"
    Alt + b:1

"amixer set Master 2%-"
    Alt + b:3
# search selected phrase
"bash $HOME/dotfiles/scripts/searcher.sh"
    Mod4 + o

"pactl set-sink-volume 0 +2%"
    XF86AudioRaiseVolume

"pactl set-sink-volume 0 -2%"
    XF86AudioLowerVolume
