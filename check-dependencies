RED='\033[0;31m'
GREEN='\033[0;32m'
NOCOLOR='\033[0m'
check() {
    if ! command -v $1; then
       echo -e "${RED}[] ${NOCOLOR}Command '$1' not found!"
    else
       echo -e "${GREEN}[] ${NOCOLOR}Command '$1' found."
    fi
}

